# ============================================================
# HOUSEPRICE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Backend Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="HOUSEPRICE AI"
API_V1_STR=/api/v1

# Server & CORS
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
DATABASE_URL=sqlite:///./houseprice_ai.db
# For PostgreSQL:
# DATABASE_URL=postgresql://houseprice:houseprice_secure_pass@localhost:5432/houseprice_ai

# Redis Configuration (Optional in local dev, utilized for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=sqlite:///mlops/mlflow.db
MLFLOW_EXPERIMENT_NAME=houseprice-ai-benchmarks

# Frontend Environment (used in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
